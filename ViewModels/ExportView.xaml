<Window x:Class="TRONIX.Modules.Views.ExportView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📊 Exportação de Relatórios de Tempo - TRONIX" Height="450" Width="800"
        WindowStartupLocation="CenterScreen" Background="#F9F9F9">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Filtrar Projeto:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,5,0"/>
            <TextBox Text="{Binding FiltroProjeto, UpdateSourceTrigger=PropertyChanged}" Width="180" Margin="0,0,15,0" Height="25"/>

            <TextBlock Text="Status:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,5,0"/>
            <ComboBox ItemsSource="{Binding ListaStatus}" SelectedItem="{Binding StatusSelecionado}" Width="120" Height="25"/>
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding SessoesExibidas}" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal" Background="White">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Header="Exportar"/>
                <DataGridTextColumn Binding="{Binding Sessao.NomeDocumento}" Header="Documento" Width="*"/>
                <DataGridTextColumn Binding="{Binding Sessao.Projetista}" Header="Projetista" Width="100"/>
                <DataGridTextColumn Binding="{Binding Sessao.Etapa}" Header="Etapa" Width="120"/>
                <DataGridTextColumn Binding="{Binding Sessao.Status}" Header="Status" Width="90"/>
                <DataGridTextColumn Binding="{Binding Sessao.HoraInicio, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Header="Início" Width="120"/>
                <DataGridTextColumn Binding="{Binding TempoTotalFormatado}" Header="Tempo Total" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="💾 Exportar Selecionados (CSV)" Command="{Binding ExportarCSVCommand}" Height="30" Width="200" Background="#27AE60" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>