<Window x:Class="TRONIX.Modules.JustificativaInatividadeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tempo Ocioso Detectado - TRONIX" Height="350" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" 
        Topmost="True" WindowStyle="None" BorderBrush="#E74C3C" BorderThickness="2" Background="#F8F9FA">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO DE ALERTA -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="⚠️" FontSize="22" Margin="0,0,8,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Tempo Ocioso / Inatividade Detectado" FontSize="14" FontWeight="Bold" Foreground="#C0392B"/>
                <TextBlock Text="O tempo de projeto foi pausado automaticamente." FontSize="10" Foreground="Gray"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="Identificamos ausência de movimentos ou troca de aplicativo. Para retornar ao trabalho e continuar a contagem, selecione ou descreva a justificativa:" 
                   TextWrapping="Wrap" FontSize="11" Foreground="#2C3E50" Margin="0,0,0,12"/>

        <!-- OPÇÕES PREDEFINIDAS E CAMPO LIVRE -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="Motivo da Inatividade / Atividade Externa:" FontSize="10" FontWeight="Bold" Foreground="Gray" Margin="0,0,0,4"/>

            <!-- COMBOBOX VAZIO NO XAML - SERÁ PREENCHIDO NO C# -->
            <ComboBox x:Name="CboMotivos" Height="26" Margin="0,0,0,8" SelectionChanged="CboMotivos_SelectionChanged"/>

            <TextBox x:Name="TxtJustificativa" Height="40" TextWrapping="Wrap" AcceptsReturn="True" FontSize="11" Padding="4"/>
        </StackPanel>

        <!-- MENSAGEM DE ERRO INLINE -->
        <TextBlock Grid.Row="3" x:Name="TxtErro" Text="Por favor, informe uma justificativa." 
                   Foreground="#E74C3C" FontSize="11" FontWeight="Bold" 
                   Visibility="Collapsed" Margin="0,4,0,0"/>

        <!-- BOTÃO DE DESBLOQUEIO -->
        <Button Grid.Row="4" Content="🔓 Confirmar Justificativa e Retomar" 
                Click="Confirmar_Click" Height="34" Background="#27AE60" Foreground="White" 
                FontWeight="Bold" FontSize="12" Margin="0,10,0,0"/>
    </Grid>
</Window>