<UserControl x:Class="TRONIX.Modules.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Margin="5">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Estilo padrão para os botões pequenos de lista -->
        <Style x:Key="BtnAdd" TargetType="Button">
            <Setter Property="Background" Value="#27AE60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="45"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
        </Style>
        <Style x:Key="BtnDel" TargetType="Button">
            <Setter Property="Background" Value="#E74C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="45"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
        </Style>
        <Style x:Key="BtnImp" TargetType="Button">
            <Setter Property="Background" Value="#ED8936"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- TELA DE LOGIN -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="220" 
                    Visibility="{Binding IsNaoAdmin, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="🔒 Acesso Restrito" FontSize="16" FontWeight="Bold" Foreground="#003366" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock Text="Digite a senha de administrador:" FontSize="10" Foreground="Gray" Margin="0,0,0,5" HorizontalAlignment="Center"/>
            <PasswordBox x:Name="TxtSenha" Height="26" Margin="0,0,0,10" PasswordChanged="TxtSenha_PasswordChanged"/>
            <Button Content="Entrar" Command="{Binding LoginAdminCommand}" Height="28" Background="#003366" Foreground="White" FontWeight="Bold"/>
        </StackPanel>

        <!-- PAINEL DE CONFIGURAÇÕES -->
        <Grid Visibility="{Binding IsAdminLogado, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="⚙️ Painel de Administração" FontSize="14" FontWeight="Bold" Foreground="#003366" Margin="0,0,0,10"/>

            <TabControl Grid.Row="1" Margin="0,0,0,10">
                <!-- ABA GERAL -->
                <TabItem Header="Geral">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="Tempo de Inatividade (Segundos):" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Text="{Binding LimiteInatividade, UpdateSourceTrigger=PropertyChanged}" Width="60" Height="24" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="Justificativas de Ociosidade:" FontWeight="SemiBold" Margin="0,0,0,5"/>

                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding NovaJustificativa, UpdateSourceTrigger=PropertyChanged}" Height="24" VerticalContentAlignment="Center"/>
                                <Button Grid.Column="1" Content="➕" Command="{Binding AddJustificativaCommand}" Style="{StaticResource BtnAdd}"/>
                                <Button Grid.Column="2" Content="❌" Command="{Binding DelJustificativaCommand}" Style="{StaticResource BtnDel}"/>
                            </Grid>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Justificativas}" SelectedItem="{Binding JustificativaSelecionada}" Margin="0,0,0,5"/>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ABA DESENHISTAS -->
                <TabItem Header="Desenhistas">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding NovoDesenhista, UpdateSourceTrigger=PropertyChanged}" Height="24" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Content="➕" Command="{Binding AddDesenhistaCommand}" Style="{StaticResource BtnAdd}"/>
                            <Button Grid.Column="2" Content="❌" Command="{Binding DelDesenhistaCommand}" Style="{StaticResource BtnDel}"/>
                        </Grid>
                        <ListBox Grid.Row="1" ItemsSource="{Binding Desenhistas}" SelectedItem="{Binding DesenhistaSelecionado}"/>
                        <Button Grid.Row="2" Content="📥 Importar do TXT" Command="{Binding ImportarDesenhistasCommand}" Style="{StaticResource BtnImp}"/>
                    </Grid>
                </TabItem>

                <!-- ABA MATERIAIS -->
                <TabItem Header="Materiais">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding NovoMaterial, UpdateSourceTrigger=PropertyChanged}" Height="24" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Content="➕" Command="{Binding AddMaterialCommand}" Style="{StaticResource BtnAdd}"/>
                            <Button Grid.Column="2" Content="❌" Command="{Binding DelMaterialCommand}" Style="{StaticResource BtnDel}"/>
                        </Grid>
                        <ListBox Grid.Row="1" ItemsSource="{Binding Materiais}" SelectedItem="{Binding MaterialSelecionado}"/>
                        <Button Grid.Row="2" Content="📥 Importar do TXT" Command="{Binding ImportarMateriaisCommand}" Style="{StaticResource BtnImp}"/>
                    </Grid>
                </TabItem>

                <!-- ABA TRATAMENTO -->
                <TabItem Header="Tratamento">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding NovaPintura, UpdateSourceTrigger=PropertyChanged}" Height="24" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Content="➕" Command="{Binding AddPinturaCommand}" Style="{StaticResource BtnAdd}"/>
                            <Button Grid.Column="2" Content="❌" Command="{Binding DelPinturaCommand}" Style="{StaticResource BtnDel}"/>
                        </Grid>
                        <ListBox Grid.Row="1" ItemsSource="{Binding Pinturas}" SelectedItem="{Binding PinturaSelecionada}"/>
                        <Button Grid.Row="2" Content="📥 Importar do TXT" Command="{Binding ImportarPinturasCommand}" Style="{StaticResource BtnImp}"/>
                    </Grid>
                </TabItem>

                <!-- ABA BANHOS -->
                <TabItem Header="Banhos">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding NovoBanho, UpdateSourceTrigger=PropertyChanged}" Height="24" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Content="➕" Command="{Binding AddBanhoCommand}" Style="{StaticResource BtnAdd}"/>
                            <Button Grid.Column="2" Content="❌" Command="{Binding DelBanhoCommand}" Style="{StaticResource BtnDel}"/>
                        </Grid>
                        <ListBox Grid.Row="1" ItemsSource="{Binding Banhos}" SelectedItem="{Binding BanhoSelecionado}"/>
                        <Button Grid.Row="2" Content="📥 Importar do TXT" Command="{Binding ImportarBanhosCommand}" Style="{StaticResource BtnImp}"/>
                    </Grid>
                </TabItem>
            </TabControl>

            <Button Grid.Row="2" Content="💾 Salvar Todas as Configurações" Command="{Binding SalvarCommand}" Height="32" Background="#27AE60" Foreground="White" FontWeight="Bold" FontSize="12"/>
        </Grid>
    </Grid>
</UserControl>