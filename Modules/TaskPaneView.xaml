<UserControl x:Class="TRONIX.Modules.TaskPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:modules="clr-namespace:TRONIX.Modules">

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TÍTULO TRONIX -->
        <TextBlock Grid.Row="0" Text="TRONIX" FontSize="20" FontWeight="Bold" 
                   Foreground="#003366" HorizontalAlignment="Center" Margin="0,5,0,10"/>

        <!-- NAVEGAÇÃO POR ABAS -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- ABA 1: CONTROLE DE TEMPO -->
            <TabItem Header="⏱️ Tempo">
                <modules:TimeTrackerView />
            </TabItem>

            <!-- ABA 2: DETALHAMENTO AUTOMÁTICO -->
            <TabItem Header="📐 Detalhamento">
                <modules:DetailingView />
            </TabItem>

            <!-- ABA 3: CONFIGURAÇÕES E LISTAS (NOVA) -->
            <TabItem Header="⚙️ Configurações">
                <modules:SettingsView />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>