<Window x:Class="TRONIX.Modules.GerenciarListasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gerenciador de Listas - TRONIX" Height="440" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#F8F9FA">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="⚙️ Gerenciamento de Opções das Listas" FontSize="14" FontWeight="Bold" Foreground="#003366" Margin="0,0,0,10"/>

        <!-- Abas de Categoria -->
        <TabControl Grid.Row="1" Margin="0,0,0,10">
            <TabItem Header="Desenhistas">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListBox x:Name="LstDesenhistas" Margin="0,0,0,8"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtNovoDesenhista" Height="24" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Content="➕ Add" Click="AddDesenhista_Click" Width="50" Height="24" Margin="4,0,0,0" Background="#27AE60" Foreground="White"/>
                        <Button Grid.Column="2" Content="❌ Del" Click="DelDesenhista_Click" Width="50" Height="24" Margin="4,0,0,0" Background="#E74C3C" Foreground="White"/>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Materiais">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListBox x:Name="LstMateriais" Margin="0,0,0,8"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtNovoMaterial" Height="24" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Content="➕ Add" Click="AddMaterial_Click" Width="50" Height="24" Margin="4,0,0,0" Background="#27AE60" Foreground="White"/>
                        <Button Grid.Column="2" Content="❌ Del" Click="DelMaterial_Click" Width="50" Height="24" Margin="4,0,0,0" Background="#E74C3C" Foreground="White"/>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Tratamento">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListBox x:Name="LstPinturas" Margin="0,0,0,8"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtNovaPintura" Height="24" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Content="➕ Add" Click="AddPintura_Click" Width="50" Height="24" Margin="4,0,0,0" Background="#27AE60" Foreground="White"/>
                        <Button Grid.Column="2" Content="❌ Del" Click="DelPintura_Click" Width="50" Height="24" Margin="4,0,0,0" Background="#E74C3C" Foreground="White"/>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Banhos">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListBox x:Name="LstBanhos" Margin="0,0,0,8"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtNovoBanho" Height="24" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Content="➕ Add" Click="AddBanho_Click" Width="50" Height="24" Margin="4,0,0,0" Background="#27AE60" Foreground="White"/>
                        <Button Grid.Column="2" Content="❌ Del" Click="DelBanho_Click" Width="50" Height="24" Margin="4,0,0,0" Background="#E74C3C" Foreground="White"/>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Barra Inferior de Ações -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="📥 Importar do TXT" Click="ImportarTXT_Click" Height="30" Background="#ED8936" Foreground="White" FontWeight="Bold" Margin="0,0,4,0"/>
            <Button Grid.Column="1" Content="💾 Salvar e Fechar" Click="Salvar_Click" Height="30" Background="#2980B9" Foreground="White" FontWeight="Bold" Margin="4,0,0,0"/>
        </Grid>
    </Grid>
</Window>